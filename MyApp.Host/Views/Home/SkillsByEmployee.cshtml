@model List<SkillDto>
@{
    var employee = (EmployeeDto)ViewBag.Employee;
    ViewData["Title"] = "Compétences – " + employee.FullName;
}

<h2>Compétences de @employee.FullName</h2>
<p class="text-muted">@employee.Email</p>

<component type="typeof(SkillList)" render-mode="Static" param-Skills="Model" />

<p class="mt-3">
    <a asp-action="AddSkill" asp-route-id="@employee.Id" class="btn btn-success">Ajouter une compétence</a>
    <a href="javascript:history.back()" class="btn btn-secondary">Retour</a>
</p>